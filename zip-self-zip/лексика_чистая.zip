// ZIP-SELF: лексер на чистом ZIP (v6)
#runtime("allocator")
#runtime("io")

ТК_КОНЕЦ = 0
ТК_ИМПУЛЬС = 1
ТК_ФУНКЦИЯ = 45
ТК_СТРУКТУРА = 44

функция это_кириллица(б1, б2) {
    если (б1 != 208) {
        если (б1 != 209) {
            возврат(0)
        }
    }
    если (б2 < 128) {
        возврат(0)
    }
    если (б2 > 191) {
        возврат(0)
    }
    возврат(1)
}

функция лексер_разобрать_полный(текст) {
    возврат(zip_lex_полный(текст))
}

функция лексер_разобрать(текст) {
    возврат(лексер_разобрать_полный(текст))
}