// ============================================
// ZIP-SELF: компилятор на чистом ZIP (v6)
// ============================================
// Stage-0: C-bootstrap один раз собирает этот драйвер.
// Stage-1+: компиляция через VM (zip_self_compile -> zip_gen_полный),
// без вызова bootstrap/zipc.
// ============================================

#runtime("syscall")
#runtime("allocator")
#runtime("io")
#runtime("файлы")

функция лексер_разобрать(текст) {
    возврат(zip_lex_полный(текст))
}

функция парсер_разобрать(текст) {
    возврат(zip_parse_полный(текст))
}

функция генератор_байткод(текст) {
    возврат(zip_gen_полный(текст))
}

функция компилировать_файл(вход, выход) {
    возврат(zip_self_compile(вход, выход))
}

функция главная() {
    н = количество_аргументов()
    если (н < 2) {
        ПечатьСтроки("Использование: zip-vm selfc.zipb <вход.zip> <выход.zipb>")
        возврат(1)
    }
    вход = получить_аргумент(1)
    выход = получить_аргумент(2)
    ПечатьСтроки("Компиляция ZIP в ZIPB через VM без C:")
    ПечатьСтроки(вход)
    код = компилировать_файл(вход, выход)
    если (код != 0) {
        ПечатьСтроки("Ошибка самокомпиляции")
        возврат(код)
    }
    ПечатьСтроки("OK: selfc")
    возврат(0)
}