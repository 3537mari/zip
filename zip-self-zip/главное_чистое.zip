}

функция разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт) {
    лев = разобрать_или(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
    если (п_есть(виды, поз, 16) == 1) {
        п_вперёд(поз)
        прав = разобрать_или(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 18, лев, прав, 0, "", 0))
    }
    возврат(лев)
}
функция разобрать_блок(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт) {
    если (п_есть(виды, поз, 10) == 1) { п_вперёд(поз) }
    голова = 0
    хвост = 0
    пока ((п_есть(виды, поз, 11) == 0) и (п_есть(виды, поз, 0) == 0)) {
        
        ст = разобрать_инструкцию(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        узел = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 20, ст, 0, 0, "", 0)
        если (голова == 0) {
            голова = узел
            хвост = узел
        } иначе {
            у_след[хвост] = узел
            хвост = узел
        }
    }
    если (п_есть(виды, поз, 11) == 1) { п_вперёд(поз) }
    возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 15, голова, 0, 0, "", 0))
}

функция разобрать_инструкцию(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт) {
    видт = п_вид(виды, поз)
    если (видт == 39) {
        п_вперёд(поз)
        з = 0
        если (п_есть(виды, поз, 11) == 0) {
            если (п_есть(виды, поз, 0) == 0) {
                з = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
            }
        }
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 14, з, 0, 0, "", 0))
    }
    если (видт == 34) {
        п_вперёд(поз)
        если (п_есть(виды, поз, 8) == 1) { п_вперёд(поз) }
        усл = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        если (п_есть(виды, поз, 9) == 1) { п_вперёд(поз) }
        тогда = разобрать_блок(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        ветка_ин = 0
        если (п_есть(виды, поз, 35) == 1) {
            п_вперёд(поз)
            // иначе если → else { if ... }; иначе → блок
            если (п_есть(виды, поз, 34) == 1) {
                ветка_ин = разобрать_инструкцию(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
            } иначе {
                ветка_ин = разобрать_блок(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
            }
        }
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 11, усл, тогда, ветка_ин, "", 0))
    }
    если (видт == 36) {
        п_вперёд(поз)
        если (п_есть(виды, поз, 8) == 1) { п_вперёд(поз) }
        усл = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        если (п_есть(виды, поз, 9) == 1) { п_вперёд(поз) }
        тело = разобрать_блок(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 12, усл, тело, 0, "", 0))
    }
    если (видт == 37) {
        п_вперёд(поз)
        имя = п_текст(тексты, поз)
        п_вперёд(поз)
        если (п_есть(виды, поз, 38) == 1) { п_вперёд(поз) }
        кол = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        тело = разобрать_блок(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 13, кол, тело, 0, имя, 0))
    }
    если (видт == 40) {
        п_вперёд(поз)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 5, 0, 0, 0, "", 0))
    }
    если (видт == 41) {
        п_вперёд(поз)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 5, 0, 0, 0, "", 0))
    }
    // выражение или присваивание
    лев = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
    если (п_есть(виды, поз, 6) == 1) {
        п_вперёд(поз)
        прав = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 10, лев, прав, 0, "", 0))
    }
    возврат(лев)
}

функция разобрать_функцию(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт) {
    п_вперёд(поз)  // функция
    имя = п_текст(тексты, поз)
    п_вперёд(поз)
    арность = 0
    парам_голова = 0
    парам_хвост = 0
    если (п_есть(виды, поз, 8) == 1) {
        п_вперёд(поз)
        пока ((п_есть(виды, поз, 9) == 0) и (п_есть(виды, поз, 0) == 0)) {
            
            пн = п_текст(тексты, поз)
            п_вперёд(поз)
            если (п_есть(виды, поз, 7) == 1) {
                п_вперёд(поз)
                п_вперёд(поз)  // тип
            }
            узел = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 20, 0, 0, 0, пн, 0)
            если (парам_голова == 0) {
                парам_голова = узел
                парам_хвост = узел
            } иначе {
                у_след[парам_хвост] = узел
                парам_хвост = узел
            }
            арность = арность + 1
            если (п_есть(виды, поз, 14) == 1) { п_вперёд(поз) }
        }
        если (п_есть(виды, поз, 9) == 1) { п_вперёд(поз) }
    }
    если (п_есть(виды, поз, 15) == 1) {
        п_вперёд(поз)
        п_вперёд(поз)
    }
    тело = разобрать_блок(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
    возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 2, парам_голова, тело, 0, имя, арность))
}

функция парсер_разобрать(виды, целые, тексты, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт) {
    поз = [0; 1]
    поз[0] = 0
    счёт[0] = 1
    голова = 0
    хвост = 0
    пока (п_есть(виды, поз, 0) == 0) {
        п_пропуск_директив(виды, тексты, поз, нток)
        если (п_есть(виды, поз, 0) == 0) {
        видт = п_вид(виды, поз)
        узел = 0
        если (видт == 42) {
            узел = разобрать_функцию(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        } иначе если (видт == 58) {
            // пропуск структуры: структура Имя { ... }
            п_вперёд(поз)
            п_вперёд(поз)
            если (п_есть(виды, поз, 10) == 1) {
                глуб = 1
                п_вперёд(поз)
                пока ((глуб > 0) и (п_есть(виды, поз, 0) == 0)) {
                    
                    если (п_есть(виды, поз, 10) == 1) { глуб = глуб + 1 }
                    если (п_есть(виды, поз, 11) == 1) { глуб = глуб - 1 }
                    п_вперёд(поз)
                }
            }
        } иначе {
            узел = разобрать_инструкцию(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        }
        если (узел != 0) {
            св = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 20, узел, 0, 0, "", 0)
            если (голова == 0) {
                голова = св
                хвост = св
            } иначе {
                у_след[хвост] = св
                хвост = св
            }
        }
        }
    }
    возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 1, голова, 0, 0, "", 0))
}
// === Генератор ZIPB ===
функция г_дописать_u16(б, з) {
    байтбуфер_дописать(б, з - (з / 256) * 256)
    байтбуфер_дописать(б, з / 256)
}
функция г_дописать_u32(б, з) {
    г_дописать_u16(б, з - (з / 65536) * 65536)
    г_дописать_u16(б, з / 65536)
}
функция г_дописать_i64(б, з) {
    х = з
    й = 0
    пока (й < 8) {
        байт = х - (х / 256) * 256
        если (байт < 0) { байт = байт + 256 }
        байтбуфер_дописать(б, байт)
        х = х / 256
        й = й + 1
    }
}


функция эмит_оп(код, ипк, оп) {
    байтбуфер_дописать(код, оп)
    ипк[0] = ипк[0] + 1
}
функция эмит_оп_u32(код, ипк, оп, з) {
    байтбуфер_дописать(код, оп)
    г_дописать_u32(код, з)
    ипк[0] = ипк[0] + 1
}
функция эмит_оп_i64(код, ипк, оп, з) {
    байтбуфер_дописать(код, оп)
    г_дописать_i64(код, з)
    ипк[0] = ипк[0] + 1
}
функция эмит_прыжок(код, ипк, оп) {
    байтбуфер_дописать(код, оп)
    поз = байтбуфер_длина(код)
    г_дописать_u32(код, 0)
    ипк[0] = ипк[0] + 1
    возврат(поз)
}

функция стр_добавить(стр_таб, стр_н, s) {
    й = 0
    н = стр_н[0]
    пока (й < н) {
        если (сравнить_строки(стр_таб[й], s) == 0) { возврат(й) }
        й = й + 1
    }
    стр_таб[н] = s
    стр_н[0] = н + 1
    возврат(н)
}

функция фн_найти(фн_имена, фн_н, имя) {
    й = 0
    пока (й < фн_н[0]) {
        если (сравнить_строки(фн_имена[й], имя) == 0) { возврат(й) }
        й = й + 1
    }
    возврат(0 - 1)
}

функция лок_найти(лок_имена, лок_н, имя) {
    й = 0
    пока (й < лок_н[0]) {
        если (сравнить_строки(лок_имена[й], имя) == 0) { возврат(й) }
        й = й + 1
    }
    возврат(0 - 1)
}

функция лок_добавить(лок_имена, лок_н, имя) {
    найд = лок_найти(лок_имена, лок_н, имя)
    если (найд >= 0) { возврат(найд) }
    н = лок_н[0]
    лок_имена[н] = имя
    лок_н[0] = н + 1
    возврат(н)
}

функция эмит_выражение(у, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н) {
    если (у == 0) {
        байтбуфер_дописать(код, 16)
        г_дописать_i64(код, 0)
        ипк[0] = ипк[0] + 1
        возврат(0)
    }
    вид = у_вид[у]
    если (вид == 5) {
        байтбуфер_дописать(код, 16)
        г_дописать_i64(код, у_цел[у])
        ипк[0] = ипк[0] + 1
        возврат(0)
    }
    если (вид == 19) {
        байтбуфер_дописать(код, 16)
        г_дописать_i64(код, у_цел[у])
        ипк[0] = ипк[0] + 1
        возврат(0)
    }
    если (вид == 6) {
        байтбуфер_дописать(код, 18)
        ипк[0] = ипк[0] + 1
        инд = стр_добавить(стр_таб, стр_н, у_имя[у])
        г_дописать_u32(код, инд)
        возврат(0)
    }
    если (вид == 7) {
        слот = лок_найти(лок_имена, лок_н, у_имя[у])
        если (слот < 0) { слот = лок_добавить(лок_имена, лок_н, у_имя[у]) }
        байтбуфер_дописать(код, 64)
        г_дописать_u32(код, слот)
        ипк[0] = ипк[0] + 1
        возврат(0)
    }
    если (вид == 8) {
        эмит_выражение(у_а[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
        эмит_выражение(у_б[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
        оп = у_имя[у]
        если (сравнить_строки(оп, "+") == 0) { байтбуфер_дописать(код, 32) }
        иначе если (сравнить_строки(оп, "-") == 0) { байтбуфер_дописать(код, 33) }
        иначе если (сравнить_строки(оп, "*") == 0) { байтбуфер_дописать(код, 34) }
        иначе если (сравнить_строки(оп, "/") == 0) { байтбуфер_дописать(код, 35) }
        иначе если (сравнить_строки(оп, "==") == 0) { байтбуфер_дописать(код, 48) }
        иначе если (сравнить_строки(оп, "!=") == 0) { байтбуфер_дописать(код, 49) }
        иначе если (сравнить_строки(оп, "<") == 0) { байтбуфер_дописать(код, 50) }
        иначе если (сравнить_строки(оп, "<=") == 0) { байтбуфер_дописать(код, 51) }
        иначе если (сравнить_строки(оп, ">") == 0) { байтбуфер_дописать(код, 52) }
        иначе если (сравнить_строки(оп, ">=") == 0) { байтбуфер_дописать(код, 53) }
        иначе если (сравнить_строки(оп, "и") == 0) { байтбуфер_дописать(код, 34) }
        иначе если (сравнить_строки(оп, "или") == 0) { байтбуфер_дописать(код, 32) }
        ипк[0] = ипк[0] + 1
        возврат(0)
    }
    если (вид == 9) {
        эмит_выражение(у_а[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
        если (сравнить_строки(у_имя[у], "-") == 0) {
            байтбуфер_дописать(код, 16)
            г_дописать_i64(код, 0)
            ипк[0] = ипк[0] + 1
            байтбуфер_дописать(код, 33)
            ипк[0] = ипк[0] + 1
        }
        возврат(0)
    }
    если (вид == 4) {
        арг = у_а[у]
        пока (арг != 0) {
            эмит_выражение(у_а[арг], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
            арг = у_след[арг]
        }
        индекс = фн_найти(фн_имена, фн_н, у_имя[у])
        если (индекс >= 0) {
            байтбуфер_дописать(код, 96)
            г_дописать_u32(код, индекс)
            ипк[0] = ипк[0] + 1
        } иначе {
            байтбуфер_дописать(код, 98)
            ипк[0] = ипк[0] + 1
            либ = стр_добавить(стр_таб, стр_н, "builtin")
            ф = стр_добавить(стр_таб, стр_н, у_имя[у])
            г_дописать_u32(код, либ)
            г_дописать_u32(код, ф)
        }
        возврат(0)
    }
    если (вид == 16) {
        если (у_в[у] == 1) {
            // [val; N] — размер только в операнде NEW_ARRAY, не на стеке
            если (у_вид[у_б[у]] == 5) {
                байтбуфер_дописать(код, 151)
                г_дописать_u32(код, у_цел[у_б[у]])
                ипк[0] = ипк[0] + 1
            } иначе {
                байтбуфер_дописать(код, 151)
                г_дописать_u32(код, 16)
                ипк[0] = ипк[0] + 1
            }
        } иначе {
            байтбуфер_дописать(код, 151)
            г_дописать_u32(код, 8)
            ипк[0] = ипк[0] + 1
        }
        возврат(0)
    }
    если (вид == 17) {
        эмит_выражение(у_а[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
        эмит_выражение(у_б[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
        байтбуфер_дописать(код, 152)
        ипк[0] = ипк[0] + 1
        возврат(0)
    }
    байтбуфер_дописать(код, 16)
    г_дописать_i64(код, 0)
    ипк[0] = ипк[0] + 1
    возврат(0)
}

функция эмит_инструкцию(у, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н) {
    если (у == 0) { возврат(0) }
    вид = у_вид[у]
    если (вид == 14) {
        если (у_а[у] != 0) {
            эмит_выражение(у_а[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
        } иначе {
            байтбуфер_дописать(код, 16)
            г_дописать_i64(код, 0)
            ипк[0] = ипк[0] + 1
        }
        байтбуфер_дописать(код, 97)
        ипк[0] = ипк[0] + 1
        возврат(0)
    }
    если (вид == 10) {
        лев = у_а[у]
        если (у_вид[лев] == 7) {
            эмит_выражение(у_б[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
            слот = лок_добавить(лок_имена, лок_н, у_имя[лев])
            байтбуфер_дописать(код, 65)
            г_дописать_u32(код, слот)
            ипк[0] = ипк[0] + 1
        } иначе если (у_вид[лев] == 17) {
            // стек: массив, значение, индекс
            эмит_выражение(у_а[лев], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
            эмит_выражение(у_б[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
            эмит_выражение(у_б[лев], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
            байтбуфер_дописать(код, 153)
            ипк[0] = ипк[0] + 1
        } иначе {
            эмит_выражение(у_б[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
            байтбуфер_дописать(код, 65)
            г_дописать_u32(код, 0)
            ипк[0] = ипк[0] + 1
        }
        возврат(0)
    }
    если (вид == 11) {
        эмит_выражение(у_а[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
        поз_иначе = эмит_прыжок(код, ипк, 82)
        эмит_инструкцию(у_б[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
        если (у_в[у] != 0) {
            поз_конца = эмит_прыжок(код, ипк, 80)
            байтбуфер_патч_u32(код, поз_иначе, ипк[0])
            эмит_инструкцию(у_в[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
            байтбуфер_патч_u32(код, поз_конца, ипк[0])
        } иначе {
            байтбуфер_патч_u32(код, поз_иначе, ипк[0])
        }
        возврат(0)
    }
    если (вид == 12) {
        нач = ипк[0]
        эмит_выражение(у_а[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
        поз_кон = эмит_прыжок(код, ипк, 82)
        эмит_инструкцию(у_б[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
        байтбуфер_дописать(код, 80)
        г_дописать_u32(код, нач)
        ипк[0] = ипк[0] + 1
        байтбуфер_патч_u32(код, поз_кон, ипк[0])
        возврат(0)
    }
    если (вид == 15) {
        сп = у_а[у]
        пока (сп != 0) {
            эмит_инструкцию(у_а[сп], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
            сп = у_след[сп]
        }
        возврат(0)
    }
    если (вид == 13) {
        // для й в 0..N { body } → упрощённый while
        // кол — диапазон
        кол = у_а[у]
        если (у_вид[кол] == 18) {
            слот = лок_добавить(лок_имена, лок_н, у_имя[у])
            эмит_выражение(у_а[кол], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
            байтбуфер_дописать(код, 65)
            г_дописать_u32(код, слот)
            ипк[0] = ипк[0] + 1
            нач = ипк[0]
            байтбуфер_дописать(код, 64)
            г_дописать_u32(код, слот)
            ипк[0] = ипк[0] + 1
            эмит_выражение(у_б[кол], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
            байтбуфер_дописать(код, 50)
            ипк[0] = ипк[0] + 1
            поз_кон = эмит_прыжок(код, ипк, 82)
            эмит_инструкцию(у_б[у], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
            байтбуфер_дописать(код, 64)
            г_дописать_u32(код, слот)
            ипк[0] = ипк[0] + 1
            байтбуфер_дописать(код, 16)
            г_дописать_i64(код, 1)
            ипк[0] = ипк[0] + 1
            байтбуфер_дописать(код, 32)
            ипк[0] = ипк[0] + 1
            байтбуфер_дописать(код, 65)
            г_дописать_u32(код, слот)
            ипк[0] = ипк[0] + 1
            байтбуфер_дописать(код, 80)
            г_дописать_u32(код, нач)
            ипк[0] = ипк[0] + 1
            байтбуфер_патч_u32(код, поз_кон, ипк[0])
        }
        возврат(0)
    }
    // выражение как инструкция — убрать результат со стека
    эмит_выражение(у, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
    байтбуфер_дописать(код, 1)
    ипк[0] = ипк[0] + 1
    возврат(0)
}
функция эмит_функцию(фн, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, стр_таб, стр_н, фн_имена, фн_н) {
    лок_имена = [0; 256]
    лок_н = [0; 1]
    лок_н[0] = 0
    ипк = [0; 1]
    ипк[0] = 0
    п = у_а[фн]
    пока (п != 0) {
        лок_добавить(лок_имена, лок_н, у_имя[п])
        п = у_след[п]
    }
    эмит_инструкцию(у_б[фн], у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, ипк, стр_таб, стр_н, фн_имена, фн_н, лок_имена, лок_н)
    байтбуфер_дописать(код, 97)
    ипк[0] = ипк[0] + 1
    возврат(лок_н[0])
}
функция собрать_модуль(прог, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, путь_выхода) {
    стр_таб = [0; 16384]
    стр_н = [0; 1]
    стр_н[0] = 0
    фн_имена = [0; 256]
    фн_арн = [0; 256]
    фн_лок = [0; 256]
    фн_н = [0; 1]
    фн_н[0] = 0

    сп = у_а[прог]
    пока (сп != 0) {
        у = у_а[сп]
        если (у_вид[у] == 2) {
            н = фн_н[0]
            фн_имена[н] = у_имя[у]
            фн_арн[н] = у_цел[у]
            стр_добавить(стр_таб, стр_н, у_имя[у])
            фн_н[0] = н + 1
        }
        сп = у_след[сп]
    }

    // эмит всех тел в отдельные буферы, потом соберём
    // Храним длины и переэмитируем: однопроходная сборка через список байтбуферов как целые id
    коды_id = [0; 256]
    сп = у_а[прог]
    пока (сп != 0) {
        у = у_а[сп]
        если (у_вид[у] == 2) {
            индекс = фн_найти(фн_имена, фн_н, у_имя[у])
            код = байтбуфер_создать()
            лок = эмит_функцию(у, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, код, стр_таб, стр_н, фн_имена, фн_н)
            если (лок < 16) { лок = 16 }
            фн_лок[индекс] = лок
            коды_id[индекс] = код
        }
        сп = у_след[сп]
    }

    out = байтбуфер_создать()
    байтбуфер_дописать(out, 90)
    байтбуфер_дописать(out, 73)
    байтбуфер_дописать(out, 80)
    байтбуфер_дописать(out, 66)
    г_дописать_u16(out, 3)
    г_дописать_u16(out, 0)
    г_дописать_u32(out, фн_н[0])
    г_дописать_u32(out, 16)
    г_дописать_u32(out, стр_н[0])
    й = 0
    пока (й < стр_н[0]) {
        с = стр_таб[й]
        дл = длина_байтов(с)
        г_дописать_u32(out, дл)
        j = 0
        пока (j < дл) {
            байтбуфер_дописать(out, байт_строки(с, j))
            j = j + 1
        }
        й = й + 1
    }

    й = 0
    пока (й < фн_н[0]) {
        имя_и = 0
        k = 0
        пока (k < стр_н[0]) {
            если (сравнить_строки(стр_таб[k], фн_имена[й]) == 0) {
                имя_и = k
                k = стр_н[0]
            }
            k = k + 1
        }
        г_дописать_u32(out, имя_и)
        г_дописать_u16(out, фн_арн[й])
        г_дописать_u16(out, фн_лок[й])
        г_дописать_u32(out, 0)
        // длина и байты кода — нужен байтбуфер_слить
        код = коды_id[й]
        дл = байтбуфер_длина(код)
        г_дописать_u32(out, дл)
        байтбуфер_слить(out, код)
        й = й + 1
    }

    байтбуфер_сохранить(out, путь_выхода)
    возврат(байтбуфер_длина(out))
}

функция компилировать_файл(вход, выход) {
    исходник = файл_прочитать(вход)
    виды = [0; 16384]
    целые = [0; 16384]
    тексты = [0; 16384]
    нток = лексер_разобрать(исходник, виды, целые, тексты)
    напечатать_строку("Токенов:")
    напечатать_число_строкой(нток)

    у_вид = [0; 16384]
    у_а = [0; 16384]
    у_б = [0; 16384]
    у_в = [0; 16384]
    у_имя = [0; 16384]
    у_цел = [0; 16384]
    у_след = [0; 16384]
    счёт = [0; 1]
    счёт[0] = 1
    прог = парсер_разобрать(виды, целые, тексты, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
    напечатать_строку("AST узлов:")
    напечатать_число_строкой(счёт[0])

    дл = собрать_модуль(прог, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, выход)
    напечатать_строку("Байт-код:")
    напечатать_число_строкой(дл)
    возврат(0)
}

функция главная() {
    если (количество_аргументов() < 3) {
        напечатать_ошибку("Использование: selfc <вход.zip> <выход.zipb>")
        возврат(1)
    }
    вход = получить_аргумент(1)
    выход = получить_аргумент(2)
    напечатать_строку("Компиляция ZIP → ZIPB (чистый ZIP):")
    напечатать_строку(вход)
    код = компилировать_файл(вход, выход)
    если (код != 0) {
        напечатать_ошибку("Ошибка компиляции")
        возврат(код)
    }
    напечатать_строку("OK:")
    напечатать_строку(выход)
    возврат(0)
}
