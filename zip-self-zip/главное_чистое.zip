#runtime("syscall")
#runtime("allocator")
#runtime("io")
#runtime("файлы")


функция это_кириллица(б1, б2) {
    если (б1 != 208) { если (б1 != 209) { возврат(0) } }
    если (б2 < 128) { возврат(0) }
    если (б2 > 191) { возврат(0) }
    возврат(1)
}
функция это_цифра(б) {
    если (б < 48) { возврат(0) }
    если (б > 57) { возврат(0) }
    возврат(1)
}
функция это_латынь(б) {
    если (б >= 65) { если (б <= 90) { возврат(1) } }
    если (б >= 97) { если (б <= 122) { возврат(1) } }
    если (б == 95) { возврат(1) }
    возврат(0)
}
функция ключевое_слово(слово) {
    если (сравнить_строки(слово, "если") == 0) { возврат(34) }
    если (сравнить_строки(слово, "иначе") == 0) { возврат(35) }
    если (сравнить_строки(слово, "пока") == 0) { возврат(36) }
    если (сравнить_строки(слово, "для") == 0) { возврат(37) }
    если (сравнить_строки(слово, "в") == 0) { возврат(38) }
    если (сравнить_строки(слово, "возврат") == 0) { возврат(39) }
    если (сравнить_строки(слово, "прервать") == 0) { возврат(40) }
    если (сравнить_строки(слово, "продолжить") == 0) { возврат(41) }
    если (сравнить_строки(слово, "функция") == 0) { возврат(42) }
    если (сравнить_строки(слово, "тип") == 0) { возврат(43) }
    если (сравнить_строки(слово, "структура") == 0) { возврат(58) }
    если (сравнить_строки(слово, "глагол") == 0) { возврат(44) }
    если (сравнить_строки(слово, "агент") == 0) { возврат(45) }
    если (сравнить_строки(слово, "поток") == 0) { возврат(46) }
    если (сравнить_строки(слово, "истина") == 0) { возврат(47) }
    если (сравнить_строки(слово, "ложь") == 0) { возврат(48) }
    если (сравнить_строки(слово, "и") == 0) { возврат(49) }
    если (сравнить_строки(слово, "или") == 0) { возврат(50) }
    если (сравнить_строки(слово, "не") == 0) { возврат(51) }
    если (сравнить_строки(слово, "ничто") == 0) { возврат(52) }
    если (сравнить_строки(слово, "Ничто") == 0) { возврат(52) }
    если (сравнить_строки(слово, "нечто") == 0) { возврат(53) }
    если (сравнить_строки(слово, "Нечто") == 0) { возврат(53) }
    если (сравнить_строки(слово, "успех") == 0) { возврат(54) }
    если (сравнить_строки(слово, "Успех") == 0) { возврат(54) }
    если (сравнить_строки(слово, "ошибка") == 0) { возврат(55) }
    если (сравнить_строки(слово, "Ошибка") == 0) { возврат(55) }
    возврат(31)
}
функция лексер_добавить(виды, целые, тексты, н, вид, цел, текст) {
    виды[н] = вид
    целые[н] = цел
    тексты[н] = текст
    возврат(н + 1)
}
функция лексер_разобрать(исходник, виды, целые, тексты) {
    длина = длина_байтов(исходник)
    н = 0
    поз = 0
    готово = 0
    пока (готово == 0) {
        // пробелы и комментарии
        пропуск = 1
        пока (пропуск == 1) {
            если (поз >= длина) {
                пропуск = 0
            } иначе {
                б = байт_строки(исходник, поз)
                если (б == 32) { поз = поз + 1 }
                иначе если (б == 9) { поз = поз + 1 }
                иначе если (б == 10) { поз = поз + 1 }
                иначе если (б == 13) { поз = поз + 1 }
                иначе если (б == 47) {
                    б2 = 0
                    если (поз + 1 < длина) { б2 = байт_строки(исходник, поз + 1) }
                    если (б2 == 47) {
                        поз = поз + 2
                        ком = 1
                        пока (ком == 1) {
                            если (поз >= длина) {
                                ком = 0
                            } иначе если (байт_строки(исходник, поз) == 10) {
                                ком = 0
                            } иначе {
                                поз = поз + 1
                            }
                        }
                    } иначе если (б2 == 42) {
                        поз = поз + 2
                        ком = 1
                        пока (ком == 1) {
                            если (поз + 1 >= длина) {
                                ком = 0
                                поз = длина
                            } иначе {
                                если (байт_строки(исходник, поз) == 42) {
                                    если (байт_строки(исходник, поз + 1) == 47) {
                                        поз = поз + 2
                                        ком = 0
                                    } иначе {
                                        поз = поз + 1
                                    }
                                } иначе {
                                    поз = поз + 1
                                }
                            }
                        }
                    } иначе {
                        пропуск = 0
                    }
                } иначе {
                    пропуск = 0
                }
            }
        }
        // fix line-comment: выше сломали поз — перепишем line comment отдельно без sentinel
        если (поз >= длина) {
            н = лексер_добавить(виды, целые, тексты, н, 0, 0, "")
            готово = 1
        } иначе {

            б = байт_строки(исходник, поз)
            б1 = 0
            если (поз + 1 < длина) { б1 = байт_строки(исходник, поз + 1) }
            если (б == 62) {
                если (б1 == 62) {
                    поз = поз + 2
                    б2 = 0
                    если (поз < длина) { б2 = байт_строки(исходник, поз) }
                    если (б2 == 62) {
                        поз = поз + 1
                        н = лексер_добавить(виды, целые, тексты, н, 3, 0, "")
                    } иначе {
                        н = лексер_добавить(виды, целые, тексты, н, 1, 0, "")
                    }
                } иначе если (б1 == 61) {
                    поз = поз + 2
                    н = лексер_добавить(виды, целые, тексты, н, 25, 0, "")
                } иначе {
                    поз = поз + 1
                    н = лексер_добавить(виды, целые, тексты, н, 24, 0, "")
                }
            } иначе если (б == 60) {
                если (б1 == 61) {
                    поз = поз + 2
                    н = лексер_добавить(виды, целые, тексты, н, 23, 0, "")
                } иначе {
                    поз = поз + 1
                    н = лексер_добавить(виды, целые, тексты, н, 22, 0, "")
                }
            } иначе если (б == 124) {
                если (б1 == 124) {
                    поз = поз + 2
                    н = лексер_добавить(виды, целые, тексты, н, 2, 0, "")
                } иначе { поз = поз + 1 }
            } иначе если (б == 33) {
                если (б1 == 61) {
                    поз = поз + 2
                    н = лексер_добавить(виды, целые, тексты, н, 27, 0, "")
                } иначе {
                    поз = поз + 1
                    н = лексер_добавить(виды, целые, тексты, н, 4, 0, "")
                }
            } иначе если (б == 126) {
                поз = поз + 1
                н = лексер_добавить(виды, целые, тексты, н, 5, 0, "")
            } иначе если (б == 61) {
                если (б1 == 61) {
                    поз = поз + 2
                    н = лексер_добавить(виды, целые, тексты, н, 26, 0, "")
                } иначе {
                    поз = поз + 1
                    н = лексер_добавить(виды, целые, тексты, н, 6, 0, "")
                }
            } иначе если (б == 45) {
                если (б1 == 62) {
                    поз = поз + 2
                    н = лексер_добавить(виды, целые, тексты, н, 15, 0, "")
                } иначе {
                    поз = поз + 1
                    н = лексер_добавить(виды, целые, тексты, н, 18, 0, "")
                }
            } иначе если (б == 46) {
                если (б1 == 46) {
                    поз = поз + 2
                    н = лексер_добавить(виды, целые, тексты, н, 16, 0, "")
                } иначе {
                    поз = поз + 1
                    н = лексер_добавить(виды, целые, тексты, н, 59, 0, "")
                }
            } иначе если (б == 58) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 7, 0, "") }
            иначе если (б == 40) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 8, 0, "") }
            иначе если (б == 41) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 9, 0, "") }
            иначе если (б == 123) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 10, 0, "") }
            иначе если (б == 125) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 11, 0, "") }
            иначе если (б == 91) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 12, 0, "") }
            иначе если (б == 93) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 13, 0, "") }
            иначе если (б == 44) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 14, 0, "") }
            иначе если (б == 59) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 60, 0, "") }
            иначе если (б == 43) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 17, 0, "") }
            иначе если (б == 42) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 19, 0, "") }
            иначе если (б == 47) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 20, 0, "") }
            иначе если (б == 37) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 21, 0, "") }
            иначе если (б == 38) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 61, 0, "") }
            иначе если (б == 64) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 56, 0, "") }
            иначе если (б == 35) { поз = поз + 1; н = лексер_добавить(виды, целые, тексты, н, 57, 0, "") }
            иначе если (б == 34) {
                поз = поз + 1
                начало = поз
                стр_ок = 1
                пока (стр_ок == 1) {
                    если (поз >= длина) {
                        стр_ок = 0
                    } иначе {
                        бс = байт_строки(исходник, поз)
                        если (бс == 34) {
                            стр_ок = 0
                        } иначе если (бс == 92) {
                            поз = поз + 1
                            если (поз < длина) { поз = поз + 1 }
                        } иначе {
                            поз = поз + 1
                        }
                    }
                }
                текст = подстрока(исходник, начало, поз - начало)
                если (поз < длина) { поз = поз + 1 }
                н = лексер_добавить(виды, целые, тексты, н, 30, 0, текст)
            } иначе если (это_цифра(б) == 1) {
                начало = поз
                есть_точка = 0
                чис_ок = 1
                пока (чис_ок == 1) {
                    если (поз >= длина) {
                        чис_ок = 0
                    } иначе {
                        бс = байт_строки(исходник, поз)
                        если (это_цифра(бс) == 1) {
                            поз = поз + 1
                        } иначе если (бс == 46) {
                если (есть_точка == 1) {
                                чис_ок = 0
                            } иначе {
                                бс2 = 0
                                если (поз + 1 < длина) { бс2 = байт_строки(исходник, поз + 1) }
                                если (это_цифра(бс2) == 1) {
                                    есть_точка = 1
                                    поз = поз + 1
                                } иначе {
                                    чис_ок = 0
                                }
                            }
                        } иначе {
                            чис_ок = 0
                        }
                    }
                }
                текст = подстрока(исходник, начало, поз - начало)
                значение = 0
                й = 0
                дл = длина_байтов(текст)
                пока (й < дл) {
                    бс = байт_строки(текст, й)
                    если (бс == 46) {
                        й = дл
                    } иначе {
                        значение = значение * 10 + (бс - 48)
                        й = й + 1
                    }
                }
                если (есть_точка == 1) {
                    н = лексер_добавить(виды, целые, тексты, н, 29, значение, текст)
                } иначе {
                    н = лексер_добавить(виды, целые, тексты, н, 28, значение, "")
                }
            } иначе если (это_кириллица(б, б1) == 1) {
                начало = поз
                кир = 0
                сл_ок = 1
                пока (сл_ок == 1) {
                    если (поз >= длина) {
                        сл_ок = 0
                    } иначе {
                        бс = байт_строки(исходник, поз)
                        бс2 = 0
                        если (поз + 1 < длина) { бс2 = байт_строки(исходник, поз + 1) }
                        если (это_кириллица(бс, бс2) == 1) {
                            поз = поз + 2
                            кир = кир + 1
                        } иначе если (это_латынь(бс) == 1) { поз = поз + 1 }
                        иначе если (это_цифра(бс) == 1) { поз = поз + 1 }
                        иначе если (бс == 95) { поз = поз + 1 }
                        иначе { сл_ок = 0 }
                    }
                }
                текст = подстрока(исходник, начало, поз - начало)
                вид = ключевое_слово(текст)
                если (вид == 31) {
                    дл = поз - начало
                    если (кир == 3) {
                        если (дл == 6) { вид = 32 }
                    }
                    если (кир == 5) {
                        если (дл == 10) { вид = 33 }
                    }
                }
                н = лексер_добавить(виды, целые, тексты, н, вид, 0, текст)
            } иначе если (это_латынь(б) == 1) {
                начало = поз
                сл_ок = 1
                пока (сл_ок == 1) {
                    если (поз >= длина) {
                        сл_ок = 0
                    } иначе {
                        бс = байт_строки(исходник, поз)
                        если (это_латынь(бс) == 1) { поз = поз + 1 }
                        иначе если (это_цифра(бс) == 1) { поз = поз + 1 }
                        иначе { сл_ок = 0 }
                    }
                }
                текст = подстрока(исходник, начало, поз - начало)
                н = лексер_добавить(виды, целые, тексты, н, ключевое_слово(текст), 0, текст)
            } иначе {
                поз = поз + 1
            }
}
    }
    возврат(н)
}
// === AST: плоские массивы ===
функция узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, вид, п0, п1, п2, имя, цел) {
    й = счёт[0]
    у_вид[й] = вид
    у_а[й] = п0
    у_б[й] = п1
    у_в[й] = п2
    у_имя[й] = имя
    у_цел[й] = цел
    у_след[й] = 0
    счёт[0] = й + 1
    возврат(й)
}

функция п_вид(виды, поз) { возврат(виды[поз[0]]) }
функция п_текст(тексты, поз) { возврат(тексты[поз[0]]) }
функция п_цел(целые, поз) { возврат(целые[поз[0]]) }
функция п_есть(виды, поз, вид) {
    если (виды[поз[0]] == вид) { возврат(1) }
    возврат(0)
}
функция п_есть2(виды, поз, в1, в2) {
    если (виды[поз[0]] == в1) { возврат(1) }
    если (виды[поз[0]] == в2) { возврат(1) }
    возврат(0)
}
функция п_вперёд(поз) { поз[0] = поз[0] + 1 }

функция п_пропуск_директив(виды, тексты, поз, нток) {
    проп = 1
    пока ((проп == 1) и (поз[0] < нток)) {
        если (п_есть(виды, поз, 57) == 0) {
            проп = 0
        } иначе {
            п_вперёд(поз)
            проп2 = 1
            пока ((проп2 == 1) и (поз[0] < нток)) {
                видт = виды[поз[0]]
                если (видт == 42) { проп2 = 0 }
                иначе если (видт == 58) { проп2 = 0 }
                иначе если (видт == 0) { проп2 = 0 }
                иначе если (видт == 57) { проп2 = 0 }
                иначе { п_вперёд(поз) }
            }
        }
    }
}

функция разобрать_первичное(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт) {
    видт = п_вид(виды, поз)
    если (видт == 28) {
        з = п_цел(целые, поз)
        п_вперёд(поз)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 5, 0, 0, 0, "", з))
    }
    если (видт == 30) {
        т = п_текст(тексты, поз)
        п_вперёд(поз)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 6, 0, 0, 0, т, 0))
    }
    если (видт == 47) {
        п_вперёд(поз)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 19, 0, 0, 0, "", 1))
    }
    если (видт == 48) {
        п_вперёд(поз)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 19, 0, 0, 0, "", 0))
    }
    если (видт == 8) {
        п_вперёд(поз)
        у = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        если (п_есть(виды, поз, 9) == 1) { п_вперёд(поз) }
        возврат(у)
    }
    если (видт == 12) {
        п_вперёд(поз)
        // [0; N] или [a, b, ...]
        первый = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        если (п_есть(виды, поз, 60) == 1) {
            п_вперёд(поз)
            повт = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
            если (п_есть(виды, поз, 13) == 1) { п_вперёд(поз) }
            возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 16, первый, повт, 1, "", 0))
        }
        голова = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 20, первый, 0, 0, "", 0)
        хв = голова
        пока ((п_есть(виды, поз, 13) == 0) и (п_есть(виды, поз, 0) == 0)) {
            
            если (п_есть(виды, поз, 14) == 1) { п_вперёд(поз) }
            эл = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
            след = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 20, эл, 0, 0, "", 0)
            у_след[хв] = след
            хв = след
        }
        если (п_есть(виды, поз, 13) == 1) { п_вперёд(поз) }
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 16, голова, 0, 0, "", 0))
    }
    // слово / корень / шаблон — одинаковый постфикс (. и []), как в C-bootstrap
    если ((видт == 31) или (видт == 32) или (видт == 33)) {
        имя = п_текст(тексты, поз)
        п_вперёд(поз)
        если (п_есть(виды, поз, 8) == 1) {
            п_вперёд(поз)
            арг_голова = 0
            арг_хвост = 0
            пока ((п_есть(виды, поз, 9) == 0) и (п_есть(виды, поз, 0) == 0)) {
                
                а = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
                узел = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 20, а, 0, 0, "", 0)
                если (арг_голова == 0) {
                    арг_голова = узел
                    арг_хвост = узел
                } иначе {
                    у_след[арг_хвост] = узел
                    арг_хвост = узел
                }
                если (п_есть(виды, поз, 14) == 1) { п_вперёд(поз) }
            }
            если (п_есть(виды, поз, 9) == 1) { п_вперёд(поз) }
            база = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 4, арг_голова, 0, 0, имя, 0)
        } иначе {
            база = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 7, 0, 0, 0, имя, 0)
        }
        пока (п_есть(виды, поз, 12) == 1) {
            п_вперёд(поз)
            инд = разобрать_выражение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
            если (п_есть(виды, поз, 13) == 1) { п_вперёд(поз) }
            база = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 17, база, инд, 0, "", 0)
        }
        возврат(база)
    }
    п_вперёд(поз)
    возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 5, 0, 0, 0, "", 0))
}

функция разобрать_унарный(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт) {
    если (п_есть(виды, поз, 18) == 1) {
        п_вперёд(поз)
        о = разобрать_унарный(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 9, о, 0, 0, "-", 0))
    }
    если (п_есть(виды, поз, 51) == 1) {
        п_вперёд(поз)
        о = разобрать_унарный(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        возврат(узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 9, о, 0, 0, "не", 0))
    }
    возврат(разобрать_первичное(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт))
}

функция разобрать_произведение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт) {
    лев = разобрать_унарный(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
    пока (п_есть2(виды, поз, 19, 20) == 1) {
        оп = "*"
        если (п_есть(виды, поз, 20) == 1) { оп = "/" }
        п_вперёд(поз)
        прав = разобрать_унарный(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        лев = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 8, лев, прав, 0, оп, 0)
    }
    возврат(лев)
}

функция разобрать_сумму(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт) {
    лев = разобрать_произведение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
    пока (п_есть2(виды, поз, 17, 18) == 1) {
        оп = "+"
        если (п_есть(виды, поз, 18) == 1) { оп = "-" }
        п_вперёд(поз)
        прав = разобрать_произведение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        лев = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 8, лев, прав, 0, оп, 0)
    }
    возврат(лев)
