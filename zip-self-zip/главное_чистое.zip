    пока (п_есть(виды, поз, 50) == 1) {
        п_вперёд(поз)
        прав = разобрать_и(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        лев = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 8, лев, прав, 0, "или", 0)
    }
