функция разобрать_сравнение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт) {
    лев = разобрать_сумму(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
    ср_ок = 1
    пока (ср_ок == 1) {
        оп = ""
        если (п_есть(виды, поз, 26) == 1) { оп = "==" }
        иначе если (п_есть(виды, поз, 27) == 1) { оп = "!=" }
        иначе если (п_есть(виды, поз, 22) == 1) { оп = "<" }
        иначе если (п_есть(виды, поз, 23) == 1) { оп = "<=" }
        иначе если (п_есть(виды, поз, 24) == 1) { оп = ">" }
        иначе если (п_есть(виды, поз, 25) == 1) { оп = ">=" }
        иначе { ср_ок = 0 }
        если (ср_ок == 1) {
            п_вперёд(поз)
            прав = разобрать_сумму(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
            лев = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 8, лев, прав, 0, оп, 0)
        }
    }
    возврат(лев)
}

функция разобрать_и(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт) {
    лев = разобрать_сравнение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
    пока (п_есть(виды, поз, 49) == 1) {
        п_вперёд(поз)
        прав = разобрать_сравнение(виды, целые, тексты, поз, нток, у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт)
        лев = узел_новый(у_вид, у_а, у_б, у_в, у_имя, у_цел, у_след, счёт, 8, лев, прав, 0, "и", 0)
    }
    возврат(лев)
}

