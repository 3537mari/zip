// ============================================
// ZIP-SELF-ZIP: ТОЧКА ВХОДА САМОКОМПИЛЯТОРА
// ============================================
// Использование:
//   zip-vm selfc.zipb <вход.zip> <выход.zipb>
// Конвейер: лексер → парсер → генератор (через zip_self_*).
// Движок компиляции на этапе v4 — тот же C-bootstrap (fixed-point).

функция лексер_разобрать(данные) {
    возврат(zip_self_lex(данные))
}

функция парсер_разобрать(токены) {
    возврат(zip_self_parse(токены))
}

функция генератор_байткод(дерево) {
    возврат(zip_self_codegen(дерево))
}

функция компилировать_файл(вход, выход) {
    возврат(zip_self_compile(вход, выход))
}

функция главная() {
    н = количество_аргументов()
    если (н < 2) {
        ПечатьСтроки("Использование: zip-vm selfc.zipb <вход.zip> <выход.zipb>")
        возврат(1)
    }
    вход = получить_аргумент(1)
    выход = получить_аргумент(2)
    код = компилировать_файл(вход, выход)
    если (код != 0) {
        ПечатьСтроки("Ошибка самокомпиляции")
        возврат(код)
    }
    ПечатьСтроки("OK: selfc")
    возврат(0)
}
