// ============================================
// ZIP-SELF: ПОЛНЫЙ ЛЕКСЕР (алгоритм без C-bootstrap)
// ============================================
// Константы = bootstrap/zipb.h TokenType.
// Разбор: zip_lex_полный — порт алгоритма C-лексера
// на VM (Rust), без вызова bootstrap/zipc.
// ============================================

#runtime("allocator")
#runtime("io")

ТК_КОНЕЦ = 0
ТК_ИМПУЛЬС = 1
ТК_ХОР = 2
ТК_СЕТЬ = 3
ТК_ФИКСАЦИЯ = 4
ТК_ПОТОК = 5
ТК_РАВНО = 6
ТК_ДВОЕТОЧИЕ = 7
ТК_ЛСКОБКА = 8
ТК_ПСКОБКА = 9
ТК_ЛФИГУРНАЯ = 10
ТК_ПФИГУРНАЯ = 11
ТК_ЦЕЛОЕ = 28
ТК_СТРОКА = 30
ТК_СЛОВО = 31
ТК_КОРЕНЬ = 32
ТК_ШАБЛОН = 33
ТК_ЕСЛИ = 34
ТК_ФУНКЦИЯ = 42

функция лексер_разобрать_полный(данные) {
    возврат(zip_lex_полный(данные))
}

функция лексер_вид(индекс) {
    возврат(zip_lex_вид(индекс))
}

функция лексер_целое(индекс) {
    возврат(zip_lex_целое(индекс))
}

функция лексер_текст(индекс) {
    возврат(zip_lex_текст(индекс))
}

функция это_кириллица_байты(б1, б2) {
    если (б1 != 208) {
        если (б1 != 209) {
            возврат(0)
        }
    }
    если (б2 < 128) {
        возврат(0)
    }
    если (б2 > 191) {
        возврат(0)
    }
    возврат(1)
}

функция главная() {
    н = количество_аргументов()
    если (н < 2) {
        а = лексер_разобрать_полный("")
        б = лексер_разобрать_полный("42")
        в = лексер_разобрать_полный("функция")
        г = лексер_разобрать_полный("СПР")
        д = лексер_разобрать_полный("САПАР")
        е = лексер_разобрать_полный(">> >>> || ! ~")
        ПечатьЧисло(а)
        ПечатьЧисло(б)
        ПечатьЧисло(в)
        ПечатьЧисло(г)
        ПечатьЧисло(д)
        ПечатьЧисло(е)
        возврат(0)
    }
    путь = получить_аргумент(1)
    данные = файл_прочитать(путь)
    количество = лексер_разобрать_полный(данные)
    ПечатьСтроки("Токенов:")
    ПечатьЧисло(количество)
    возврат(0)
}
