// ============================================
// ZIP-SELF-ZIP: ЛЕКСЕР (конвейер на ZIP)
// ============================================
// API на ZIP; тяжёлая разборка — zip_self_lex (VM → C-bootstrap).
#runtime("allocator")
#runtime("io")

ТК_КОНЕЦ = 0
ТК_СЛОВО = 14
ТК_ЦЕЛОЕ = 15
ТК_СТРОКА = 17
ТК_ФУНКЦИЯ = 24

функция лексер_разобрать(данные) {
    возврат(zip_self_lex(данные))
}

функция лексер_количество(токены) {
    возврат(zip_self_lex_count(токены))
}
