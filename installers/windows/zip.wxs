<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="ZIP Programming Language" Language="1049"
           Version="3.0.0" Manufacturer="ZIP Community"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="ZIP">
          <Component Id="ZipCompiler" Guid="*">
            <File Id="zipc.exe" Source="payload\zipc.exe" KeyPath="yes" />
          </Component>
          <Component Id="ZipVM" Guid="*">
            <File Id="zip_vm.exe" Name="zip-vm.exe" Source="payload\zip-vm.exe" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="ZIP" />
      </Directory>
    </Directory>
    <Component Id="PathEnvironment" Guid="*" Directory="INSTALLFOLDER">
      <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no"
                   Part="last" Action="set" System="yes" />
    </Component>
    <Feature Id="MainFeature" Title="ZIP" Level="1">
      <ComponentRef Id="ZipCompiler" />
      <ComponentRef Id="ZipVM" />
      <ComponentRef Id="PathEnvironment" />
    </Feature>
  </Product>
</Wix>
