// ZIP STD: ТЕНЗОРЫ (чистый ZIP, v4)
#runtime("allocator")

функция создать_тензор(р0, р1, р2, р3) {
    возврат(zip_std_tensor_new(р0, р1, р2, р3))
}

функция заполнить_тензор(т, значение) {
    возврат(zip_std_tensor_fill(т, значение))
}

функция тензор_всего(т) {
    возврат(zip_std_tensor_total(т))
}

функция матричное_умножение(а, б, м, к, н) {
    возврат(zip_std_gemm(а, б, м, к, н))
}
