// ============================================
// ZIP STD: ОБУЧАЕМЫЕ НЕЙРОСЕТИ
// ============================================

тип Слой {
    веса: Тензор,
    смещения: Тензор,
    вход: целое,
    выход: целое,
    активация: целое,
    последний_вход: Тензор,
    последний_выход: Тензор,
    градиенты_весов: Тензор,
    градиенты_смещений: Тензор,
}

функция релу(х) {
    если (х > 0.0) { возврат(х) }
    возврат(0.0)
}

функция релу_производная(х) {
    если (х > 0.0) { возврат(1.0) }
    возврат(0.0)
}

функция сигмоид(х) {
    #link("libm")
    возврат(1.0 / (1.0 + exp(-х)))
}

функция сигмоид_производная(у) {
    возврат(у * (1.0 - у))
}

функция создать_слой(вход, выход, активация) {
    веса = создать_тензор(вход, выход, 0, 0)
    смещения = создать_тензор(выход, 1, 0, 0)
    градиенты_весов = создать_тензор(вход, выход, 0, 0)
    градиенты_смещений = создать_тензор(выход, 1, 0, 0)
    инициализировать_ксавье(веса, вход, выход)
    заполнить_тензор(смещения, выход, 1, 0.0)
    возврат(веса, смещения, вход, выход, активация, градиенты_весов, градиенты_смещений)
}

функция прямой_проход_слоя(слой_веса, слой_смещения, вход_р, выход_р, активация, вход) {
    з = матричное_умножение(вход, слой_веса, 1, вход_р, выход_р)
    выход = создать_тензор(1, выход_р, 0, 0)
    и = 0
    пока (и < выход_р) {
        и = и + 1
    }
    возврат(выход)
}

функция обратный_проход_слоя(слой, градиент_выхода, скорость_обучения) {
    возврат(0)
}
