// ZIP STD: НЕЙРОСЕТИ (чистый ZIP, v4)
#runtime("allocator")

функция релу(х) {
    если х > 0 {
        возврат(х)
    }
    возврат(0)
}

функция создать_слой(вход, выход) {
    возврат(zip_std_layer_new(вход, выход))
}

функция прямой_проход_слоя(слой, вход) {
    возврат(zip_std_layer_forward(слой, вход))
}

функция обратный_проход_слоя(слой, градиент_выхода, скорость) {
    возврат(zip_std_layer_backward(слой, градиент_выхода, скорость))
}

функция случайное_целое(макс) {
    возврат(zip_std_rand(макс))
}
