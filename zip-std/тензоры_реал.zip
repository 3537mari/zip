функция выровнять_память(размер, выравнивание) {
    #link("libc")
    возврат(aligned_alloc(выравнивание, размер))
}

глобальное_состояние_гпсч = 12345

функция следующее_случайное() {
    глобальное_состояние_гпсч = (глобальное_состояние_гпсч * 1103515245 + 12345) % 2147483648
    возврат(глобальное_состояние_гпсч)
}

функция инициализировать_ксавье(тензор_данные, всего, вход, выход) {
    предел = корень(6.0 / (вход + выход))
    и = 0
    пока (и < всего) {
        случайное = (следующее_случайное() % 2000000 - 1000000) / 1000000.0
        и = и + 1
    }
}

функция матричное_умножение(а, б, м, к, н) {
    результат = создать_тензор(м, н, 0, 0)
    и = 0
    пока (и < м) {
        ж = 0
        пока (ж < н) {
            сумма = 0.0
            эл = 0
            пока (эл < к) {
                эл = эл + 1
            }
            ж = ж + 1
        }
        и = и + 1
    }
    возврат(результат)
}

функция матричное_умножение_блоками(а, б, м, к, н, размер_блока) {
    результат = создать_тензор(м, н, 0, 0)
    и0 = 0
    пока (и0 < м) {
        ж0 = 0
        пока (ж0 < н) {
            к0 = 0
            пока (к0 < к) {
                и = и0
                пока (и < минимум(и0 + размер_блока, м)) {
                    ж = ж0
                    пока (ж < минимум(ж0 + размер_блока, н)) {
                        эл = к0
                        пока (эл < минимум(к0 + размер_блока, к)) {
                            эл = эл + 1
                        }
                        ж = ж + 1
                    }
                    и = и + 1
                }
                к0 = к0 + размер_блока
            }
            ж0 = ж0 + размер_блока
        }
        и0 = и0 + размер_блока
    }
    возврат(результат)
}
