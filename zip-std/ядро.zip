// ============================================
// ZIP STD: ЯДРО
// Базовые функции для всех программ
// ============================================

// Корень ЧТВ — память
ЧТВ = { А-А: ЧАТАВ, И-А: ЧИТВА, О-О: ЧОТВО }

// Корень СПР — счёт
СПР = { А-А: САПАР, И-А: СИПРА, О-О: СПОРО }

// Корень ПХД — поток
ПХД = { А-А: ПАХАД, И-А: ПИХДА, О-О: ПОХДО }

// ============================================
// Функции работы с памятью
// ============================================

// Выделить буфер размером N байт
// Возвращает указатель
ПАМЯТЬ_ВЫДЕЛИТЬ(размер) {
    // Внутренний вызов к системному аллокатору
    #link("libc")
    ВЫДЕЛИТЬ(размер)
}

// Освободить буфер
ПАМЯТЬ_ОСВОБОДИТЬ(указатель) {
    #link("libc")
    ОСВОБОДИТЬ(указатель)
}

// Скопировать N байт из источника в назначение
ПАМЯТЬ_КОПИРОВАТЬ(назначение, источник, размер) {
    #link("libc")
    КОПИРОВАТЬ(назначение, источник, размер)
}

// ============================================
// Функции работы с числами
// ============================================

// Сложение
ЧИСЛО_СЛОЖИТЬ(а, б) {
    САПАР(а, б)
}

// Умножение
ЧИСЛО_УМНОЖИТЬ(а, б) {
    САПАР(а, б)
}

// ============================================
// Функции работы с потоками
// ============================================

// Создать новый асинхронный поток
ПОТОК_СОЗДАТЬ(функция) {
    ЖАВАТ~ {
        функция()
    }
}

// Ожидать завершения потока
ПОТОК_ОЖИДАТЬ(поток) {
    ОЖИДАТЬ(поток)
}