// Корень СПР — счёт / вычисление
СПР = {
    А-А: САПАР,
    Е-А: СЕПАР,
    Ё-А: СЁПАР,
    И-А: СИПРА,
    О-О: СПОРО,
    У-А: СУПРА,
    Ы-А: СЫПРА,
    Э-А: СЭПРА,
    Ю-А: СЮПРА,
    Я-А: СЯПРА
}

// Корень ЧТВ — память
ЧТВ = {
    А-А: ЧАТАВ,
    Е-А: ЧЕТАВ,
    Ё-А: ЧЁТАВ,
    И-А: ЧИТВА,
    О-О: ЧОТВО,
    У-А: ЧУТВА,
    Ы-А: ЧЫТВА,
    Э-А: ЧЭТВА,
    Ю-А: ЧЮТВА,
    Я-А: ЧЯТВА
}
