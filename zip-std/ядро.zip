// === Математика ===
функция корень(число) {
    #link("libm")
    возврат(sqrt(число))
}

функция синус(угол) {
    #link("libm")
    возврат(sin(угол))
}

функция косинус(угол) {
    #link("libm")
    возврат(cos(угол))
}

// === Работа с файлами ===
функция открыть_файл(путь) {
    #link("libc")
    возврат(fopen(путь, "r"))
}

функция закрыть_файл(файл) {
    #link("libc")
    возврат(fclose(файл))
}

функция читать_файл(файл, размер) {
    #link("libc")
    возврат(fread(файл, размер))
}

// === Время ===
функция текущее_время() {
    #link("libc")
    возврат(time(0))
}

// === Память ===
функция память_выделить(размер) {
    #link("libc")
    возврат(malloc(размер))
}

функция память_освободить(указатель) {
    #link("libc")
    возврат(free(указатель))
}

// ============================================
// ИТЕРАТОРЫ (Идея 11)
// ============================================

// Создать итератор из множества (СИПРА → СЫПРА)
функция СЫПРА_из_СИПРА(множество) {
    возврат(СЫПРА(множество))
}

// Собрать сумму элементов итератора (демо-хелпер)
функция СЫПРА_сумма(итератор) {
    сумма = 0
    для элемент в итератор {
        сумма = сумма + элемент
    }
    возврат(сумма)
}

