СПР = {
    А-А: САПАР,
    Е-А: СЕПАР,
    Ё-А: СЁПАР,
    И-А: СИПРА,
    О-О: СПОРО,
    У-А: СУПРА,
    Ы-А: СЫПРА,
    Э-А: СЭПРА,
    Ю-А: СЮПРА,
    Я-А: СЯПРА
}

// Корень ЧТВ — память
