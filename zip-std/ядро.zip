// === Работа с числами ===
функция модуль(число) {
    если (число < 0) { возврат(-число) }
    возврат(число)
}

функция минимум(а, б) {
    если (а < б) { возврат(а) }
    возврат(б)
}

функция максимум(а, б) {
    если (а > б) { возврат(а) }
    возврат(б)
}

