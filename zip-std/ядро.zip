    А-А: ЧАТАВ,
    Е-А: ЧЕТАВ,
    Ё-А: ЧЁТАВ,
    И-А: ЧИТВА,
    О-О: ЧОТВО,
    У-А: ЧУТВА,
    Ы-А: ЧЫТВА,
    Э-А: ЧЭТВА,
    Ю-А: ЧЮТВА,
    Я-А: ЧЯТВА
}
