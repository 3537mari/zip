// ============================================
// ZIP STD: ЯДРО (чистый ZIP, v4)
// ============================================

#runtime("syscall")
#runtime("allocator")
#runtime("io")

функция модуль(число) {
    если число < 0 {
        возврат(0 - число)
    }
    возврат(число)
}

функция минимум(а, б) {
    если а < б {
        возврат(а)
    }
    возврат(б)
}

функция максимум(а, б) {
    если а > б {
        возврат(а)
    }
    возврат(б)
}

функция возвести(основание, степень) {
    если степень == 0 {
        возврат(1)
    }
    результат = 1
    для и в 0..степень {
        результат = результат * основание
    }
    возврат(результат)
}

функция корень(число) {
    если число < 0 {
        возврат(0)
    }
    если число == 0 {
        возврат(0)
    }
    х = число / 2
    для и в 0..32 {
        х = (х + число / х) / 2
    }
    возврат(х)
}

функция длина_строки(строка) {
    возврат(zip_std_strlen(строка))
}

функция соединить_строки(а, б) {
    возврат(zip_std_strcat(а, б))
}

функция копировать_строку(строка) {
    возврат(zip_std_strdup(строка))
}

функция сравнить_строки(а, б) {
    возврат(zip_std_strcmp(а, б))
}

функция СИПРА(начальный_размер) {
    возврат(zip_std_sipra_new(начальный_размер))
}

функция СИПРА_добавить(множество, элемент) {
    возврат(zip_std_sipra_push(множество, элемент))
}

функция СИПРА_получить(множество, индекс) {
    возврат(zip_std_sipra_get(множество, индекс))
}

функция СИПРА_длина(множество) {
    возврат(zip_std_sipra_len(множество))
}
