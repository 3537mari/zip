// ZIP STD: криптография без OpenSSL
// AES-256-GCM — чистый ZIP: подключайте zip-std/крипто_aes_zip.zip
#runtime("allocator")

функция хеш_ша256(данные, длина) {
    возврат(zip_std_sha256(данные, длина))
}

функция хеш_ша3_256(данные) {
    возврат(zip_std_sha3_256(данные))
}

функция случайные_байты(количество) {
    возврат(zip_crypto_random(количество))
}

функция kyber1024_генерация_ключей() {
    возврат(zip_crypto_kyber_keygen())
}

функция kyber1024_инкапсуляция(публичный_hex) {
    возврат(zip_crypto_kyber_encap(публичный_hex))
}

функция kyber1024_декапсуляция(шифротекст_hex, секретный_hex) {
    возврат(zip_crypto_kyber_decap(шифротекст_hex, секретный_hex))
}

функция dilithium5_генерация_ключей() {
    возврат(zip_crypto_dilithium_keygen())
}

функция dilithium5_подписать(сообщение, секретный_hex) {
    возврат(zip_crypto_dilithium_sign(сообщение, секретный_hex))
}

функция dilithium5_проверить(сообщение, подпись_hex, публичный_hex) {
    возврат(zip_crypto_dilithium_verify(сообщение, подпись_hex, публичный_hex))
}

функция constant_time_eq(a, b) {
    возврат(zip_crypto_ct_eq(a, b))
}
