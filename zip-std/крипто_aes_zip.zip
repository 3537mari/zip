// ============================================
// ZIP STD: AES-256-GCM НА ЧИСТОМ ZIP
// ============================================
// Без C. Без RustCrypto. Только ZIP.
// Битовые операции — через арифметику.
// NIST SP 800-38D + FIPS 197.
// ============================================

функция байт_xor(a, b) {
    результат = 0
    степень = 1
    aa = a
    bb = b
    для и в 0..8 {
        бит_a = aa - (aa / 2) * 2
        бит_b = bb - (bb / 2) * 2
        если (бит_a != бит_b) {
            результат = результат + степень
        }
        aa = aa / 2
        bb = bb / 2
        степень = степень * 2
    }
    возврат(результат)
}

функция байт_and(a, b) {
    результат = 0
    степень = 1
    aa = a
    bb = b
    для и в 0..8 {
        бит_a = aa - (aa / 2) * 2
        бит_b = bb - (bb / 2) * 2
        если (бит_a == 1) {
            если (бит_b == 1) {
                результат = результат + степень
            }
        }
        aa = aa / 2
        bb = bb / 2
        степень = степень * 2
    }
    возврат(результат)
}

функция байт_mod256(x) {
    если (x < 0) {
        x = 0 - x
    }
    возврат(x - (x / 256) * 256)
}

функция байт_shl1(a) {
    возврат(байт_mod256(a * 2))
}

функция байт_shr(a, n) {
    результат = a
    для и в 0..(n) {
        результат = результат / 2
    }
    возврат(результат)
}

функция байт_shl(a, n) {
    результат = a
    для и в 0..(n) {
        результат = байт_mod256(результат * 2)
    }
    возврат(результат)
}

функция s_box(x) {
    т = [
        99, 124, 119, 123, 242, 107, 111, 197, 48, 1, 103, 43, 254, 215, 171, 118,
        202, 130, 201, 125, 250, 89, 71, 240, 173, 212, 162, 175, 156, 164, 114, 192,
        183, 253, 147, 38, 54, 63, 247, 204, 52, 165, 229, 241, 113, 216, 49, 21,
        4, 199, 35, 195, 24, 150, 5, 154, 7, 18, 128, 226, 235, 39, 178, 117,
        9, 131, 44, 26, 27, 110, 90, 160, 82, 59, 214, 179, 41, 227, 47, 132,
        83, 209, 0, 237, 32, 252, 177, 91, 106, 203, 190, 57, 74, 76, 88, 207,
        208, 239, 170, 251, 67, 77, 51, 133, 69, 249, 2, 127, 80, 60, 159, 168,
        81, 163, 64, 143, 146, 157, 56, 245, 188, 182, 218, 33, 16, 255, 243, 210,
        205, 12, 19, 236, 95, 151, 68, 23, 196, 167, 126, 61, 100, 93, 25, 115,
        96, 129, 79, 220, 34, 42, 144, 136, 70, 238, 184, 20, 222, 94, 11, 219,
        224, 50, 58, 10, 73, 6, 36, 92, 194, 211, 172, 98, 145, 149, 228, 121,
        231, 200, 55, 109, 141, 213, 78, 169, 108, 86, 244, 234, 101, 122, 174, 8,
        186, 120, 37, 46, 28, 166, 180, 198, 232, 221, 116, 31, 75, 189, 139, 138,
        112, 62, 181, 102, 72, 3, 246, 14, 97, 53, 87, 185, 134, 193, 29, 158,
        225, 248, 152, 17, 105, 217, 142, 148, 155, 30, 135, 233, 206, 85, 40, 223,
        140, 161, 137, 13, 191, 230, 66, 104, 65, 153, 45, 15, 176, 84, 187, 22
    ]
    возврат(т[байт_mod256(x)])
}

функция rcon(i) {
    т = [1, 2, 4, 8, 16, 32, 64, 128, 27, 54]
    возврат(т[i])
}

функция gf_xtime(a) {
    hi = байт_and(a, 128)
    a2 = байт_shl1(a)
    если (hi != 0) {
        возврат(байт_xor(a2, 27))
    }
    возврат(a2)
}

функция gf_mul(a, b) {
    p = 0
    aa = байт_mod256(a)
    bb = байт_mod256(b)
    для и в 0..8 {
        если (байт_and(bb, 1) != 0) {
            p = байт_xor(p, aa)
        }
        aa = gf_xtime(aa)
        bb = байт_shr(bb, 1)
    }
    возврат(p)
}

функция скопировать16(источник, цель) {
    для и в 0..16 {
        цель[и] = источник[и]
    }
}

функция xor16(a, b, out) {
    для и в 0..16 {
        out[и] = байт_xor(a[и], b[и])
    }
}

функция aes256_расширить_ключ(ключ, расписание) {
    для и в 0..32 {
        расписание[и] = ключ[и]
    }
    для и в 8..60 {
        t0 = расписание[(и - 1) * 4]
        t1 = расписание[(и - 1) * 4 + 1]
        t2 = расписание[(и - 1) * 4 + 2]
        t3 = расписание[(и - 1) * 4 + 3]
        ост = и - (и / 8) * 8
        если (ост == 0) {
            temp = t0
            t0 = t1
            t1 = t2
            t2 = t3
            t3 = temp
            t0 = s_box(t0)
            t1 = s_box(t1)
            t2 = s_box(t2)
            t3 = s_box(t3)
            t0 = байт_xor(t0, rcon(и / 8 - 1))
        } иначе {
            если (ост == 4) {
                t0 = s_box(t0)
                t1 = s_box(t1)
                t2 = s_box(t2)
                t3 = s_box(t3)
            }
        }
        расписание[и * 4] = байт_xor(расписание[(и - 8) * 4], t0)
        расписание[и * 4 + 1] = байт_xor(расписание[(и - 8) * 4 + 1], t1)
        расписание[и * 4 + 2] = байт_xor(расписание[(и - 8) * 4 + 2], t2)
        расписание[и * 4 + 3] = байт_xor(расписание[(и - 8) * 4 + 3], t3)
    }
    возврат(0)
}

функция sub_bytes(состояние) {
    для и в 0..16 {
        состояние[и] = s_box(состояние[и])
    }
}

функция shift_rows(состояние) {
    temp = [0; 16]
    скопировать16(состояние, temp)
    состояние[1] = temp[5]
    состояние[5] = temp[9]
    состояние[9] = temp[13]
    состояние[13] = temp[1]
    состояние[2] = temp[10]
    состояние[6] = temp[14]
    состояние[10] = temp[2]
    состояние[14] = temp[6]
    состояние[3] = temp[15]
    состояние[7] = temp[3]
    состояние[11] = temp[7]
    состояние[15] = temp[11]
}

функция mix_columns(состояние) {
    для кол в 0..4 {
        o = кол * 4
        a0 = состояние[o]
        a1 = состояние[o + 1]
        a2 = состояние[o + 2]
        a3 = состояние[o + 3]
        состояние[o] = байт_xor(байт_xor(байт_xor(gf_mul(a0, 2), gf_mul(a1, 3)), a2), a3)
        состояние[o + 1] = байт_xor(байт_xor(байт_xor(a0, gf_mul(a1, 2)), gf_mul(a2, 3)), a3)
        состояние[o + 2] = байт_xor(байт_xor(байт_xor(a0, a1), gf_mul(a2, 2)), gf_mul(a3, 3))
        состояние[o + 3] = байт_xor(байт_xor(байт_xor(gf_mul(a0, 3), a1), a2), gf_mul(a3, 2))
    }
}

функция add_round_key(состояние, расписание, раунд) {
    для и в 0..16 {
        состояние[и] = байт_xor(состояние[и], расписание[раунд * 16 + и])
    }
}

функция aes256_зашифровать_блок(блок, расписание, выход) {
    состояние = [0; 16]
    скопировать16(блок, состояние)
    add_round_key(состояние, расписание, 0)
    для раунд в 1..14 {
        sub_bytes(состояние)
        shift_rows(состояние)
        mix_columns(состояние)
        add_round_key(состояние, расписание, раунд)
    }
    sub_bytes(состояние)
    shift_rows(состояние)
    add_round_key(состояние, расписание, 14)
    скопировать16(состояние, выход)
    возврат(0)
}

функция constant_time_eq(a, b, длина) {
    различие = 0
    для и в 0..(длина) {
        различие = различие + байт_xor(a[и], b[и])
    }
    если (различие == 0) {
        возврат(1)
    }
    возврат(0)
}

функция gf128_mul(x, y, z) {
    для и в 0..16 {
        z[и] = 0
    }
    v = [0; 16]
    для и в 0..16 {
        v[и] = y[и]
    }
    для и в 0..128 {
        байт = и / 8
        бит = 7 - (и - байт * 8)
        маска = байт_shl(1, бит)
        если (байт_and(x[байт], маска) != 0) {
            для j в 0..16 {
                z[j] = байт_xor(z[j], v[j])
            }
        }
        lsb = байт_and(v[15], 1)
        для j в 0..15 {
            младший = байт_and(v[14 - j], 1)
            v[15 - j] = байт_xor(байт_shr(v[15 - j], 1), байт_shl(младший, 7))
        }
        v[0] = байт_shr(v[0], 1)
        если (lsb != 0) {
            v[0] = байт_xor(v[0], 225)
        }
    }
    возврат(0)
}

функция ghash_накопить(y, блок, h) {
    для j в 0..16 {
        y[j] = байт_xor(y[j], блок[j])
    }
    t = [0; 16]
    gf128_mul(y, h, t)
    скопировать16(t, y)
}

функция ghash(h, данные, длина, y) {
    для и в 0..16 {
        y[и] = 0
    }
    количество = (длина + 15) / 16
    для и в 0..(количество) {
        блок = [0; 16]
        начало = и * 16
        для j в 0..16 {
            если (начало + j < длина) {
                блок[j] = данные[начало + j]
            } иначе {
                блок[j] = 0
            }
        }
        ghash_накопить(y, блок, h)
    }
    lenb = [0; 16]
    биты = длина * 8
    lenb[15] = байт_mod256(биты)
    lenb[14] = байт_mod256(биты / 256)
    lenb[13] = байт_mod256(биты / 65536)
    lenb[12] = байт_mod256(биты / 16777216)
    ghash_накопить(y, lenb, h)
    возврат(0)
}

функция inc32(счётчик) {
    перенос = 1
    для j в 0..4 {
        поз = 15 - j
        сумма = счётчик[поз] + перенос
        счётчик[поз] = байт_mod256(сумма)
        перенос = сумма / 256
    }
}

функция aes256_gcm_шифровать_с_iv(данные, длина, ключ, iv, шифротекст, тег) {
    расписание = [0; 240]
    aes256_расширить_ключ(ключ, расписание)

    ноль = [0; 16]
    h = [0; 16]
    aes256_зашифровать_блок(ноль, расписание, h)

    j0 = [0; 16]
    для и в 0..12 {
        j0[и] = iv[и]
    }
    j0[12] = 0
    j0[13] = 0
    j0[14] = 0
    j0[15] = 1

    счётчик = [0; 16]
    скопировать16(j0, счётчик)
    количество = (длина + 15) / 16
    для и в 0..(количество) {
        inc32(счётчик)
        кейстрим = [0; 16]
        aes256_зашифровать_блок(счётчик, расписание, кейстрим)
        начало = и * 16
        для j в 0..16 {
            если (начало + j < длина) {
                шифротекст[начало + j] = байт_xor(данные[начало + j], кейстрим[j])
            }
        }
    }

    s = [0; 16]
    ghash(h, шифротекст, длина, s)
    маска = [0; 16]
    aes256_зашифровать_блок(j0, расписание, маска)
    xor16(s, маска, тег)
    возврат(0)
}

функция aes256_gcm_расшифровать(шифротекст, длина, ключ, iv, тег, открытый) {
    расписание = [0; 240]
    aes256_расширить_ключ(ключ, расписание)

    ноль = [0; 16]
    h = [0; 16]
    aes256_зашифровать_блок(ноль, расписание, h)

    j0 = [0; 16]
    для и в 0..12 {
        j0[и] = iv[и]
    }
    j0[12] = 0
    j0[13] = 0
    j0[14] = 0
    j0[15] = 1

    s = [0; 16]
    ghash(h, шифротекст, длина, s)
    маска = [0; 16]
    aes256_зашифровать_блок(j0, расписание, маска)
    ожидаемый = [0; 16]
    xor16(s, маска, ожидаемый)

    равны = constant_time_eq(тег, ожидаемый, 16)
    если (равны == 0) {
        напечатать_ошибку("GCM: аутентификация не прошла")
        возврат(1)
    }

    счётчик = [0; 16]
    скопировать16(j0, счётчик)
    количество = (длина + 15) / 16
    для и в 0..(количество) {
        inc32(счётчик)
        кейстрим = [0; 16]
        aes256_зашифровать_блок(счётчик, расписание, кейстрим)
        начало = и * 16
        для j в 0..16 {
            если (начало + j < длина) {
                открытый[начало + j] = байт_xor(шифротекст[начало + j], кейстрим[j])
            }
        }
    }
    возврат(0)
}

функция шифровать_аес(данные, длина, ключ, шифротекст, iv, тег) {
    для и в 0..12 {
        iv[и] = случайное_целое(256)
    }
    возврат(aes256_gcm_шифровать_с_iv(данные, длина, ключ, iv, шифротекст, тег))
}

функция расшифровать_аес(шифротекст, длина, ключ, iv, тег, открытый) {
    возврат(aes256_gcm_расшифровать(шифротекст, длина, ключ, iv, тег, открытый))
}
