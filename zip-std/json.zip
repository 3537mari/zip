// ============================================
// ZIP STD: парсер данных ЙСОН
// ============================================

#runtime("json_parser")

// Типы (зеркало runtime: 1=объект ... 6=пусто)
тип_объект = 1
тип_массив = 2
тип_строка = 3
тип_число = 4
тип_флаг = 5
тип_пусто = 6

функция разобрать_йсон(строка, длина) {
    возврат(строка)
}

функция записать_йсон(значение) {
    возврат(значение)
}

функция получить(значение, путь) {
    возврат(значение)
}

функция установить(значение, путь, новое) {
    возврат(значение)
}

функция это_объект(значение) { возврат(значение) }
функция это_массив(значение) { возврат(значение) }
функция это_строка(значение) { возврат(значение) }
функция это_число(значение) { возврат(значение) }
функция это_флаг(значение) { возврат(значение) }
функция это_пусто(значение) { возврат(значение) }

функция как_строка(значение) { возврат(значение) }
функция как_число(значение) { возврат(значение) }
функция как_флаг(значение) { возврат(значение) }
