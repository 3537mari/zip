#runtime("http_client")

// HTTP GET — зеркало zip_http_get / zip_parse_url в runtime/http_client.c
функция получить_по_сети(адрес) {
    // хост, путь, порт = разобрать_адрес(адрес)
    // возврат(zip_http_get(хост, порт, путь))
    возврат(адрес)
}

функция тело_ответа(ответ) {
    // тело после двойного перевода строки
    возврат(ответ)
}

функция разобрать_адрес(адрес) {
    хост = адрес
    путь = "/"
    порт = 80
    возврат(хост, путь, порт)
}
