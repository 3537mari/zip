// ============================================
// ZIP STD: СЕТЬ
// ============================================

тип Сокет {
    дескриптор: целое,
    адрес: строка,
    порт: целое,
}

функция создать_сокет(адрес, порт) {
    #link("libc")
    дескриптор = socket(2, 1, 0)
    #link("libc")
    connect(дескриптор, адрес, порт)
    возврат(дескриптор, адрес, порт)
}

функция отправить(дескриптор, данные) {
    #link("libc")
    возврат(send(дескриптор, данные, длина_строки(данные), 0))
}

функция получить(дескриптор, размер) {
    буфер = память_выделить(размер)
    #link("libc")
    получено = recv(дескриптор, буфер, размер, 0)
    возврат(буфер, получено)
}

функция закрыть_сокет(дескриптор) {
    #link("libc")
    возврат(close(дескриптор))
}

функция разобрать_url(url) {
    хост = url
    путь = "/"
    порт = 80
    возврат(хост, путь, порт)
}

функция http_get(url) {
    части = разобрать_url(url)
    сокет = создать_сокет(части, 80)
    запрос = "GET / HTTP/1.0\r\n\r\n"
    отправить(сокет, запрос)
    ответ = получить(сокет, 4096)
    закрыть_сокет(сокет)
    возврат(ответ)
}
