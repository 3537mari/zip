#runtime("https_client")

функция получить(адрес) {
    // zip_http_or_https_get(адрес)
    возврат(адрес)
}

функция получить_https(адрес) {
    // zip_http_or_https_get(адрес)
    возврат(адрес)
}

функция разобрать_адрес(адрес) {
    хост = адрес
    путь = "/"
    порт = 443
    возврат(хост, путь, порт)
}
