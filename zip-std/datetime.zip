#runtime("datetime")

функция сейчас() {
    возврат(0)
}

функция год(метка) {
    возврат(метка)
}

функция месяц(метка) {
    возврат(метка)
}

функция день(метка) {
    возврат(метка)
}

функция час(метка) {
    возврат(метка)
}

функция минута(метка) {
    возврат(метка)
}

функция секунда(метка) {
    возврат(метка)
}

функция форматировать(метка, формат) {
    возврат(метка)
}

функция собрать(г, м, д, ч, мин, с) {
    возврат(г)
}

функция разобрать(строка, формат) {
    возврат(строка)
}

функция добавить(метка, интервал) {
    возврат(метка)
}

функция разница(первая, вторая) {
    возврат(первая)
}

функция секунд(н) {
    возврат(н)
}

функция минут(н) {
    возврат(н)
}

функция часов(н) {
    возврат(н)
}

функция дней(н) {
    возврат(н)
}

функция недель(н) {
    возврат(н)
}
