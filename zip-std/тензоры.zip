    5A;8 (@2 > 0) { 2A53> = 2A53> * @2 }
    5A;8 (@3 > 0) { 2A53> = 2A53> * @3 }
    5A;8 (2A53> <= 0) { 2A53> = 1 }
    40==K5 = ?0<OBL_2K45;8BL(2A53> * 8)
    2>72@0B(40==K5, @0, @1, @2, @3, 2A53>)
