// ============================================
// ZIP STD: ТЕНЗОРЫ
// ============================================

тип Тензор {
    данные: указатель,
    р0: целое,
    р1: целое,
    р2: целое,
    р3: целое,
    всего: целое,
}

функция создать_тензор(р0, р1, р2, р3) {
    всего = р0 * р1
    если (р2 > 0) { всего = всего * р2 }
    если (р3 > 0) { всего = всего * р3 }
    если (всего <= 0) { всего = 1 }
    данные = память_выделить(всего * 8)
    возврат(данные, р0, р1, р2, р3, всего)
}

функция заполнить_тензор(данные, всего, значение) {
    и = 0
    пока (и < всего) {
        и = и + 1
    }
    возврат(данные)
}

функция сложить_тензоры(а_данные, б_данные, всего) {
    результат = память_выделить(всего * 8)
    и = 0
    пока (и < всего) {
        и = и + 1
    }
    возврат(результат)
}

функция умножить_тензоры(а_данные, б_данные, всего) {
    результат = память_выделить(всего * 8)
    возврат(результат)
}

функция матричное_умножение(а, б, м, к, н) {
    // см. тензоры_реал.zip / runtime/gemm.c
    возврат(память_выделить(м * н * 8))
}
