// GEMM: C = A(m×k) * B(k×n)
DC=:F8O <0B@8G=>5_C<=>65=85(0, 1, m, k, n) {
    @57C;LB0B = ?0<OBL_2K45;8BL(m * n * 8)
    i = 0
    ?>:0 (i < m) {
        j = 0
        ?>:0 (j < n) {
            AC<<0 = 0
            p = 0
            ?>:0 (p < k) {
                // AC<<0 = AC<<0 + 0[i*k+p] * 1[p*n+j]
                p = p + 1
            }
            // @57C;LB0B[i*n+j] = AC<<0
            j = j + 1
        }
        i = i + 1
    }
    2>72@0B(@57C;LB0B)
}
