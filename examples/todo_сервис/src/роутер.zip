// ============================================
// HTTP-РОУТЕР TodoAPI
// ============================================
// Маршруты:
//   GET    /health
//   POST   /api/вход
//   GET    /api/задачи
//   POST   /api/задачи
//   GET    /api/задачи/{id}
//   PUT    /api/задачи/{id}
//   DELETE /api/задачи/{id}
//
// Агент TodoAPI (состояние: задачи, токены, следующий_id)
// реализован в zip-std/runtime/todo_api.c

функция главная() {
    ПечатьСтроки("роутер.zip — маршруты REST (runtime todo_api)")
}
