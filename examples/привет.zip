// Первая программа на языке ZIP
// Демонстрация базового потока VSO

// Объявление корней
СПР = { А-А: САПАР, И-А: СИПРА, О-О: СПОРО }
ЧТВ = { А-А: ЧАТАВ, И-А: ЧИТВА, О-О: ЧОТВО }
ЖВТ = { А-А: ЖАВАТ, И-А: ЖИВТА, О-О: ЖОВТО }

// Основной поток: рождение → счёт → фиксация
ЖАВАТ(1) >> САПАР(2, 3) >> ЧАТАВ!

// Параллельный хор: три глагола одновременно
САПАР(10) || САПАР(20) || САПАР(30) >> ЧАТАВ!

// Асинхронный поток
ЖАВАТ~ { САПАР(100) >> ЧАТАВ! }