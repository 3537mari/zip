// Программа с медленными операциями (для зип-профиль)

функция фибоначчи(н) {
    если (н < 2) {
        возврат(н)
    }
    а = фибоначчи(н - 1)
    б = фибоначчи(н - 2)
    возврат(а + б)
}

функция медленная_операция() {
    сумма = 0
    для индекс в 0..1000000 {
        сумма = сумма + индекс
    }
    возврат(сумма)
}

функция главная() {
    результат_а = фибоначчи(28)
    ПечатьЧисло(результат_а)

    результат_б = медленная_операция()
    ПечатьЧисло(результат_б)
}

главная()
