// Программа с медленными операциями (для зип-профиль)
// Цикл для/диапазон: используем пока. Идентификаторы только кириллица.

функция фибоначчи(н) {
    если (н < 2) {
        возврат(н)
    }
    а = фибоначчи(н - 1)
    б = фибоначчи(н - 2)
    возврат(а + б)
}

функция медленная_операция() {
    сумма = 0
    счётчик = 0
    пока (счётчик < 1000000) {
        сумма = сумма + счётчик
        счётчик = счётчик + 1
    }
    возврат(сумма)
}

функция главная() {
    результат_а = фибоначчи(28)
    ПечатьЧисло(результат_а)

    результат_б = медленная_операция()
    ПечатьЧисло(результат_б)
}

главная()
