// Демонстрация ИИ-советника
// Компилируйте с --ии-советник

функция дорогая_функция(х) {
    сумма = 0
    для и в 0..х {
        сумма = сумма + и * и
    }
    возврат(сумма)
}

функция проверить_пароль(пароль) {
    возврат(пароль)
}

функция главная() {
    для и в 0..10000 {
        ПечатьЧисло(дорогая_функция(100))
    }
}
