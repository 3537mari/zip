ЕД_МС = 1
ЕД_М = 2
ЕД_КГ = 3

функция главная() {
    // Временные интервалы
    задержка = измерить(500, ЕД_МС)
    таймаут = измерить(30, ЕД_МС)

    // Расстояния
    путь = измерить(1500, ЕД_М)

    // Физика
    масса = измерить(75, ЕД_КГ)

    // Печать всех
    ПечатьСтроки("Задержка:")
    измерить_печать(задержка)

    ПечатьСтроки("Путь:")
    измерить_печать(путь)

    ПечатьСтроки("Масса:")
    измерить_печать(масса)

    // Сложение совместимых
    общее_время = измерить_сложить(задержка, таймаут)
    ПечатьСтроки("Общее время:")
    измерить_печать(общее_время)
}
