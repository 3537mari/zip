// Демонстрация эпигенетики (Идея 2)

@ускорить(уровень = 3)
@кэшировать(размер = 1024)
функция дорогая_функция(х) {
    возврат(х * х + 2 * х + 1)
}

@шифровать(алгоритм = "AES-GCM")
функция секретная(данные) {
    возврат(данные)
}

@параллелить(потоков = 4)
функция параллельная(массив) {
    возврат(массив)
}

@сон(интервал = "5m")
функция фоновая() {
    возврат(0)
}

@тест(случай = 10)
функция тестируемая(х) {
    возврат(х - 1)
}

функция главная() {
    ПечатьЧисло(дорогая_функция(10))
    ПечатьСтроки("Эпигенетика работает")
}
