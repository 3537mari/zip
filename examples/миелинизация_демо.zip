// Демонстрация JIT-компиляции горячего цикла (Идея 5 — Миелинизация)
@пластичность(порог = 3)
функция горячий_цикл(н) {
    сумма = 0
    для и в 0..н {
        сумма = сумма + и * и + 1
    }
    возврат(сумма)
}

функция главная() {
    результат = 0
    для и в 0..30 {
        результат = горячий_цикл(20000)
    }
    ПечатьЧисло(результат)
}