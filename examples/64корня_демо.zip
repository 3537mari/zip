// Демонстрация всех категорий корней (Идея 7)

// Глагол высшего порядка — управление
КМД = { А-А: КАМАД }
УПР = { А-А: УПАР }

// Тип данных — строка
СТР = { А-А: САТАР, И-А: СТРА }

// Модификатор — константа
КНС = { А-А: КАНАС }

// Специальный — тест
ТСТ = { А-А: ТАСТ }

функция главная() {
    // Управление
    КАМАД("выполнить")
    УПАР("потоком")

    // Строка
    текст = СТРА("Привет")
    САТАР(текст)

    // Константа
    КАНАС(42)

    // Тест
    ТАСТ("проверка_суммы")

    ПечатьСтроки("Все 64 корня доступны")
}
