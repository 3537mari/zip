// ============================================
// Демонстрация: программа через ZIP runtime (syscalls)
// ============================================

#runtime("чистый_zip")
#runtime("syscall")
#runtime("allocator")
#runtime("io")
#runtime("файлы")

функция главная() {
    // 1. Вывод через syscalls
    sys_write(1, "=== ЧИСТЫЙ ZIP ===\n", 64)

    // 2. Аллокатор
    буфер = выделить(1024)
    если буфер != 0 {
        sys_write(1, "Аллокатор: OK\n", 32)
    }

    // 3. Вывод числа
    sys_write(1, "Число: ", 16)
    напечатать_число_строкой(42)

    // 4. Запись в файл
    файл_записать("zip_clean_demo.txt", "Привет из чистого ZIP!\n")
    sys_write(1, "Файл записан\n", 32)

    // 5. Чтение файла
    содержимое = файл_прочитать("zip_clean_demo.txt")
    если содержимое != 0 {
        sys_write(1, "Прочитано: ", 32)
        напечатать(содержимое)
    }

    // 6. Выход
    sys_exit(0)
}
