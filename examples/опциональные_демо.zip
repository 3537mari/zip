// Демонстрация Идей 14-15 — Ничто/Нечто + Успех/Ошибка

функция найти(значение) {
    если (значение == 20) {
        возврат(Нечто(1))
    }
    возврат(Ничто)
}

функция делить(а, б) {
    если (б == 0) {
        возврат(Ошибка("деление на ноль"))
    }
    возврат(Успех(а / б))
}

функция главная() {
    // Тест Нечто
    результат = найти(20)
    если (результат — Нечто) {
        ПечатьСтроки("Найдено по индексу:")
        ПечатьЧисло(нечто_значение(результат))
    }

    // Тест Ничто
    нет = найти(99)
    если (нет — Ничто) {
        ПечатьСтроки("99 не найдено")
    }

    // Тест Успех
    деление = делить(10, 2)
    если (деление — Успех) {
        ПечатьСтроки("10 / 2 =")
        ПечатьЧисло(успех_значение(деление))
    }

    // Тест Ошибка
    сбой = делить(10, 0)
    если (сбой — Ошибка) {
        ПечатьСтроки(ошибка_текст(сбой))
    }
}
