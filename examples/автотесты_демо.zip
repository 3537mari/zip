// Демонстрация автогенерации тестов

@тест(случай = 20, диапазон = "0..100", границы = да)
функция сложить(а, б) {
    возврат(а + б)
}

@тест(случай = 10, диапазон = "1..10", границы = да)
функция умножить(а, б) {
    возврат(а * б)
}

функция главная() {
    ПечатьСтроки("Тесты будут сгенерированы автоматически")
}
