// Демонстрация итераторов (Идея 11)
функция главная() {
    массив = СИПРА(10)
    СИПРА_добавить(массив, 10)
    СИПРА_добавить(массив, 20)
    СИПРА_добавить(массив, 30)
    СИПРА_добавить(массив, 40)
    СИПРА_добавить(массив, 50)

    сумма = 0
    для элемент в СЫПРА_из_СИПРА(массив) {
        ПечатьЧисло(элемент)
        сумма = сумма + элемент
    }

    ПечатьСтроки("Сумма:")
    ПечатьЧисло(сумма)
}
