#!/usr/bin/env zipc
#зависимость("тензоры = 1.0")

// Тестовая программа для проверки плагинов
@ускорить(уровень = 3)
функция сложить(а, б) {
    возврат(а + б)
}

функция главная() {
    результат = сложить(2, 3)
    ПечатьЧисло(результат)

    // Использование корней
    СПР = { А-А: САПАР, И-А: СИПРА }
    данные = СИПРА(10)
    СИПРА_добавить(данные, 42)

    ПечатьЧисло(САПАР(данные))
}
