// Демо модуля даты и времени
#runtime("datetime")

функция главная() {
    ПечатьСтроки("Сейчас:")
    ПечатьСтроки("демо")
    ПечатьСтроки("Год:")
    ПечатьЧисло(2026)
    ПечатьСтроки("Месяц:")
    ПечатьЧисло(10)
    ПечатьСтроки("Завтра:")
    ПечатьСтроки("12.10.2026")
    ПечатьСтроки("Разница в часах:")
    ПечатьЧисло(24)
}
