// Бенчмарк SIMD-оптимизации
функция скалярное_произведение(размер) {
    сумма = 0
    для и в 0..размер {
        сумма = сумма + и * (и * 2)
    }
    возврат(сумма)
}

функция главная() {
    размер = 10000000
    результат = скалярное_произведение(размер)
    печать_число(результат)
    возврат(результат)
}
