// Демонстрация 10 типов шаблонов (Идея 8 — Гласные)
СПР = {
    А-А: САПАР, Е-А: СЕПАР, Ё-А: СЁПАР, И-А: СИПРА, О-О: СПОРО,
    У-А: СУПРА, Ы-А: СЫПРА, Э-А: СЭПРА, Ю-А: СЮПРА, Я-А: СЯПРА
}

функция главная() {
    данные = СИПРА(10)
    свойство = СЕПАР(0)
    итератор = СЫПРА(3)
    ПечатьЧисло(данные)
    ПечатьЧисло(свойство)
    ПечатьЧисло(итератор)
}