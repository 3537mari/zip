// Демонстрация comptime: вычисления на этапе компиляции (R2)
@comptime
функция факториал(н) {
    если (н < 2) {
        возврат(1)
    } иначе {
        возврат(н * факториал(н - 1))
    }
}

@comptime
функция число_фибоначчи(н) {
    если (н < 2) {
        возврат(н)
    } иначе {
        возврат(число_фибоначчи(н - 1) + число_фибоначчи(н - 2))
    }
}

функция главная() {
    ПечатьЧисло(факториал(10))
    ПечатьЧисло(число_фибоначчи(20))
}