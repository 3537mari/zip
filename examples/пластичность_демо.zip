// Демонстрация авто-оптимизации горячих путей (Идея 4 — Пластичность)

@пластичность(порог = 100)
функция сложная_математика(х) {
    сумма = 0
    для и в 0..х {
        сумма = сумма + и * и
    }
    возврат(сумма)
}

функция главная() {
    результат = 0
    для и в 0..1000 {
        результат = сложная_математика(100)
    }
    ПечатьЧисло(результат)
}