// Демонстрация потоков и агентов

поток обработка_чисел {
    источник = СИПРА(3)
    фильтр квадрат = САПАР(2)
    фильтр сумма = САПАР(1)
    приёмник = ЧАТАВ(результат)
}

агент Счётчик {
    состояние {
        всего: Целое = 0
    }

    функция увеличить() {
        всего = всего + 1
    }
}

функция главная() {
    запустить_поток(обработка_чисел)
    счётчик = создать_Счётчик()
    счётчик.увеличить()
    счётчик.увеличить()
    счётчик.увеличить()
    ПечатьСтроки("Всего:")
    ПечатьЧисло(счётчик.всего)
}
