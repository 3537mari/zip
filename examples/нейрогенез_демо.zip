// Демонстрация нейрогенеза
// Компилятор сам найдёт паттерн и создаст композитный глагол

@нейрогенез(порог = 2)
функция пайплайн_обработки(данные) {
    шаг1 = САПАР(данные)
    шаг2 = САПАР(шаг1)
    шаг3 = САПАР(шаг2)
    возврат(шаг3)
}

функция главная() {
    для и в 0..5 {
        результат = пайплайн_обработки(и)
        ПечатьЧисло(результат)
    }
}
